# Python virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Distribution / packaging
dist/
build/
*.egg
*.egg-info/

# Logs
logs/
*.log
pipeline_*.log

# Environment / secrets
.env
.env.local
.env.*.local

# State / runtime data
state/
*.state
*.pkl

# Runtime browser + credential state (9Router, LinkedIn session)
.tiktok-linkedin/
*.tokens.json

# Scraped corpus: data/ & *.jsonl TRACKED (hasil scrap publik), karena hasil
# scraping adalah output utama pipeline (bukan sampah). Hanya output TRANSISEN
# (run metrics / improve output / temp) yang di-exclude:
data/benchmarks/
data/manifests/*.improve.jsonl
*.tmp
# pastikan folder penting selalu ada di repo meski kosong
!data/
!data/raw/
!data/samples/
!data/manifests/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
