# Python virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Distribution / packaging
dist/
build/
*.egg
*.egg-info/

# Logs
logs/
*.log
pipeline_*.log

# Environment / secrets
.env
.env.local
.env.*.local

# State / runtime data
state/
*.state
*.pkl

# Runtime browser + credential state (9Router, LinkedIn session)
.tiktok-linkedin/
*.tokens.json

# Exported session cookies (TM-19) — full account credentials, never commit.
# Covers the cwd/repo-relative names browser_selector._DEFAULT_COOKIE_FILES probes.
tiktok_cookies.json
tiktok_cookies.txt
tiktok-cookies.json
tiktok-cookies.txt

# Scraped corpus: data/ output TIDAK di-track lagi (privacy — berisi data asli
# pengguna TikTok: handle, komentar, timestamp). Yang tersisa di repo hanya
# placeholder .gitkeep + fixture sintetis data/samples/. Semua output runtime
# acquisition (raw/curated/normalized/enriched/rejected/manifests) lokal saja:
data/raw/*
!data/raw/.gitkeep
data/curated/*
data/normalized/*
data/enriched/*
data/rejected/*
data/manifests/*
!data/manifests/.gitkeep
!data/
!data/raw/
!data/samples/
!data/samples/*
!data/manifests/
data/benchmarks/
*.tmp

# Claude Code: skills/commands are tracked; local state and credentials are not
.claude/settings.local.json
.claude/.credentials.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Agent tooling output — regenerated locally, never committed
graphify-out/
